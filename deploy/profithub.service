[Unit]
Description=ProfitHub static web server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/radxa/apps/profithub/site
ExecStart=/usr/local/bin/python3 -m http.server 8088 --bind 0.0.0.0 --directory /home/radxa/apps/profithub/site
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
